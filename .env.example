# Le Water — environment variables
#
# These power the /api/balance serverless function (public balance lookup).
# Set them in the Vercel project (Settings → Environment Variables), NOT in the
# client bundle. They are read server-side only and must never be exposed to the
# browser, so they are intentionally NOT prefixed with VITE_.

# Supabase project URL (same project as the POS). e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key (server-side only). Grants access to the
# public_lookup_balance RPC. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=